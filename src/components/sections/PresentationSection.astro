---
import { Image } from 'astro:assets';
import { mascots } from '../../assets/images';
import Button from '../Button.astro';
---

<section class="chapter presentation" id="apresentacao" aria-labelledby="presentation-title">
      <div class="wrap split-section">
        <div class="section-copy reveal-up">
          <p class="kicker"><span></span>Prazer, somos a ALFABI</p>
          <h2 id="presentation-title">Um mundo de<br>possibilidades.<br><span class="text-outline">Um jeito só seu.</span></h2>
          <p class="section-lead">Bem-vindos ao Espaço AlfaBi.</p>
          <p>Somos um lugar onde seu filho pode alcançar seus objetivos, se desenvolver, crescer e se tornar a melhor versão de si mesmo!</p>
          <div class="age-pill"><span class="color-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>Para crianças de 3 a 12 anos</div>
          <Button variant="text"  href="#missao">Conheça o que nos move <svg aria-hidden="true"><use href="#arrow"/></svg></Button>
        </div>
        <div class="discovery-art reveal-zoom" aria-label="Os personagens coloridos da marca ALFABI">
          <span class="art-orbit" aria-hidden="true"></span><span class="art-orbit second" aria-hidden="true"></span>
          <span class="art-label label-top">CURIOSIDADE PARA DESCOBRIR</span>
          <Image src={mascots} width={mascots.width} height={mascots.height} loading="lazy" alt="Os cinco mascotes geométricos da ALFABI em 3D, com braços, mãos, pernas e pés, nas cores azul, vermelho, verde, laranja e roxo." widths={[320, 453, 640, 906]} sizes="(max-width: 760px) 85vw, 453px" format="webp" quality={90} decoding="async" />
          <span class="art-sticker"><svg aria-hidden="true"><use href="#heart"/></svg>Afeto para crescer.</span>
          <span class="art-spark" aria-hidden="true">✳</span>
          <span class="art-label label-bottom">CADA CRIANÇA É ÚNICA.</span>
        </div>
      </div>
    </section>

<style>
  .discovery-art {
    padding-block: 56px 88px;
  }

  .art-sticker {
    bottom: 7%;
  }

  .label-bottom {
    bottom: 0;
  }

  @media (max-width: 760px) {
    .discovery-art {
      padding-block: 44px 76px;
    }
  }
</style>
