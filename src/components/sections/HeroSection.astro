---
import Button from '../Button.astro';
---

<section class="hero-scene" id="hero-scene" aria-labelledby="hero-title">
      <div class="hero-frame" id="hero-frame">
        <div class="wrap hero-main">
          <div class="hero-copy">
            <p class="eyebrow" data-intro><span class="eyebrow-mark" aria-hidden="true">✳</span>Pequenos passos. Grandes descobertas.</p>
            <h1 class="hero-title" id="hero-title" data-intro><span class="title-line">Cada <span class="title-blue">descoberta</span></span><span class="title-line">começa com</span><span class="title-final text-outline">acolhimento.<svg class="title-stroke" viewBox="0 0 350 18" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M3 10C75 2 230 3 345 8M60 15c80-7 170-5 228-3"/></svg></span></h1>
            <p class="hero-description" data-intro>Um espaço para aprender, desenvolver habilidades e crescer com afeto. No seu ritmo, do seu jeito.</p>
            <div class="hero-actions" data-intro>
              <Button variant="primary" beam  data-contact="visit" href="https://wa.me/5527998596818?text=Ol%C3%A1%21%20Gostaria%20de%20agendar%20uma%20visita%20%C3%A0%20ALFABI." target="_blank" rel="noopener noreferrer">Agendar uma visita<svg aria-hidden="true"><use href="#arrow"/></svg></Button>
              <Button variant="secondary"  data-contact="team" href="https://wa.me/5527998596818" target="_blank" rel="noopener noreferrer">Conversar com a equipe<svg aria-hidden="true"><use href="#chat"/></svg></Button>
            </div>
            <p class="small-promise" data-intro><svg aria-hidden="true"><use href="#heart"/></svg>Aqui, cada criança é única.</p>
          </div>
          <div class="hero-visual" id="hero-visual" data-intro>
            <div class="visual-glow" aria-hidden="true"></div>
            <div class="scene-label" aria-hidden="true"><span class="tiny-dot"></span>AFETO EM CADA ENCONTRO</div>
            <div class="video-composition" id="video-composition">
              <img class="video-media video-poster" src="/assets/hero/poster.jpg" width="960" height="540" fetchpriority="high" alt="Três professoras da ALFABI em uma cena de acolhimento com os personagens da marca.">
              <!-- Real provided footage, transcoded to H.264 all-intra. No autoplay, no loop.
                   Original: documentacao/video-original/VIDEO1-original.mp4. The poster is a frame of that same video. -->
              <video class="video-media hero-video" id="hero-video" muted playsinline preload="auto" poster="/assets/hero/poster.jpg" width="1920" height="1080" aria-label="Professoras da ALFABI acenam enquanto os mascotes entram na cena. O movimento acompanha a rolagem." aria-describedby="scene-help"></video>
            </div>
            <p class="video-state" id="video-state" role="status" aria-live="polite"></p>
            <div class="scene-signature" aria-hidden="true"><span class="color-dots"><i></i><i></i><i></i><i></i><i></i></span>Acolher. Ensinar. Transformar.</div>
            <div class="geometry geometry-square" data-depth="-22" aria-hidden="true"></div>
            <div class="geometry geometry-dot" data-depth="18" aria-hidden="true"></div>
            <div class="geometry geometry-arc" data-depth="-15" aria-hidden="true"></div>
            <svg class="geometry geometry-star" data-depth="24" aria-hidden="true"><use href="#spark"/></svg>
            <svg class="geometry-path" viewBox="0 0 84 90" aria-hidden="true"><path d="M10 65C70 86 75 8 40 17 1 30 50 72 74 36"/></svg>
          </div>
        </div>
        <div class="wrap hero-bottom">
          <span class="bottom-note"><svg aria-hidden="true"><use href="#spark"/></svg>Educação com afeto, em cada detalhe.</span>
          <Button variant="unstyled" class="scroll-cue" id="scroll-cue" type="button" aria-describedby="scene-help">Role para descobrir<svg aria-hidden="true"><use href="#down"/></svg></Button>
          <span class="scene-progress" aria-hidden="true"><span class="progress-track"><i class="progress-fill" id="progress-fill"></i></span><span class="progress-label" id="progress-label">00%</span></span>
        </div>
        <p id="scene-help" style="position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%)">Role para baixo para avançar a cena e para cima para voltar. Os botões de contato permanecem disponíveis. Com movimento reduzido, a apresentação é estática.</p>
      </div>
    </section>

<script>
import { ALFABI_CONFIG } from '../../config/site';
    const scene = document.getElementById('hero-scene');
    const frame = document.getElementById('hero-frame');
    const video = document.getElementById('hero-video');
    const visual = document.getElementById('hero-visual');
    const status = document.getElementById('video-state');
    const progressFill = document.getElementById('progress-fill');
    const progressLabel = document.getElementById('progress-label');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const playhead = { progress: 0 };
    let gsapContext, scrollTween, distance = 0, duration = 0;
    let latestTime = 0, seekFrame = 0, refreshTimer, loadingTimer;
    let librariesReady = false, metadataReady = false, failed = false, started = false;
    let libraryPromise, blobURL;
    let loadingBlob = false;
    let initialAnchorRestored = false;

    function loadScript(src) {
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src; script.async = true; script.crossOrigin = 'anonymous';
        const timer = setTimeout(() => reject(new Error('Library load timed out')), 8000);
        script.onload = () => { clearTimeout(timer); resolve(); };
        script.onerror = () => { clearTimeout(timer); reject(new Error('Library unavailable')); };
        document.head.appendChild(script);
      });
    }
    function loadLibraries() {
      if (!libraryPromise) libraryPromise = loadScript(ALFABI_CONFIG.gsap)
        .then(() => loadScript(ALFABI_CONFIG.scrollTrigger))
        .then(() => { gsap.registerPlugin(ScrollTrigger); librariesReady = true; });
      return libraryPromise;
    }
    function cleanScroll() {
      if (scrollTween) { scrollTween.scrollTrigger?.kill(); scrollTween.kill(); scrollTween = null; }
      gsapContext?.revert(); gsapContext = null;
      scene.style.removeProperty('height');
      cancelAnimationFrame(seekFrame); seekFrame = 0;
      started = false; video.pause();
    }
    function staticScene(message = '') {
      cleanScroll(); document.documentElement.classList.add('scene-static');
      status.textContent = message;
    }
    function failVideo() {
      if (failed) return;
      failed = true; clearTimeout(loadingTimer);
      visual.classList.add('video-unavailable');
      staticScene('Cada descoberta merece um acolhimento especial.');
    }

    // Single-flight seeking: while a seek is in progress we only overwrite latestTime.
    // seeked schedules one new request for the newest target, never an intermediate queue.
    function pumpSeek() {
      seekFrame = 0;
      if (failed || motion.matches || video.seeking || video.readyState < 2 || !metadataReady) return;
      const target = Math.min(Math.max(latestTime, 0), Math.max(0, duration - .001));
      if (Math.abs(video.currentTime - target) < .012) return;
      try { video.currentTime = target; } catch { failVideo(); }
    }
    function scheduleSeek() {
      if (!seekFrame) seekFrame = requestAnimationFrame(pumpSeek);
    }
    function updateScene() {
      latestTime = playhead.progress * Math.max(0, duration - .001);
      progressFill.style.transform = `scaleX(${playhead.progress})`;
      progressLabel.textContent = `${Math.round(playhead.progress * 100).toString().padStart(2, '0')}%`;
      scheduleSeek();
    }
    function measure() {
      // One outer container owns all scrub distance; sticky content fills its final viewport.
      const mobile = matchMedia('(max-width: 760px)').matches;
      distance = Math.round(Math.max(mobile ? 850 : 1200, Math.min(mobile ? 1500 : 2600, duration * (mobile ? 240 : 350))));
      scene.style.height = `${frame.offsetHeight + distance}px`;
    }
    function refresh() {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(() => {
        if (!started) return;
        measure(); ScrollTrigger.refresh(); updateScene();
      }, 120);
    }
    function setupScroll() {
      if (started || failed || motion.matches || !librariesReady || !metadataReady) return;
      document.documentElement.classList.remove('scene-static'); status.textContent = '';
      started = true; video.pause(); measure();
      gsapContext = gsap.context(() => {
        // Native sticky avoids pin spacers and preserves a single, bounded hero container.
        scrollTween = gsap.to(playhead, {
          progress: 1, ease: 'none', onUpdate: updateScene,
          scrollTrigger: { id: 'alfabi-video', trigger: scene, start: 'top top', end: () => `+=${distance}`,
            scrub: .35, invalidateOnRefresh: true, onRefreshInit: measure,
            onRefresh: () => requestAnimationFrame(updateScene) }
        });
        document.querySelectorAll('[data-depth]').forEach(layer => {
          gsap.to(layer, { y: Number(layer.dataset.depth), ease: 'none',
            scrollTrigger: { trigger: scene, start: 'top top', end: () => `+=${distance}`, scrub: .65, invalidateOnRefresh: true } });
        });
        if (performance.now() < 6000 && scrollY < 30) {
          gsap.from('.hero-copy [data-intro]', { opacity: 0, y: 14, duration: .85, stagger: .08, ease: 'power3.out', clearProps: 'opacity,transform' });
          gsap.from('.hero-visual', { opacity: 0, scale: .975, y: 8, duration: 1.2, delay: .2, ease: 'expo.out', clearProps: 'opacity,transform' });
        }
      }, scene);
      ScrollTrigger.refresh(); updateScene();
      if (!initialAnchorRestored && location.hash) {
        initialAnchorRestored = true;
        requestAnimationFrame(() => document.getElementById(location.hash.slice(1))?.scrollIntoView({ behavior: 'instant', block: 'start' }));
      }
    }
    function onMetadata() {
      if (!Number.isFinite(video.duration) || video.duration <= 0) return;
      duration = video.duration; metadataReady = true; video.pause(); setupScroll();
    }
    function frameAvailable() {
      clearTimeout(loadingTimer);
      if (failed || motion.matches) return;
      const firstFrame = !visual.classList.contains('video-ready');
      visual.classList.add('video-ready'); status.textContent = '';
      scheduleSeek();
      if (firstFrame) refresh();
    }
    async function ensureSeekable() {
      if (loadingBlob || blobURL || failed || motion.matches || !metadataReady) return;
      if (video.seekable.length && video.seekable.end(video.seekable.length - 1) > .1) return;
      // Some basic HTTP servers do not implement byte ranges. Chromium then exposes
      // a zero-length seekable interval even after decoding the first frame.
      // A local Blob of the same ~5 MB MP4 restores random access without a backend.
      loadingBlob = true;
      try {
        const response = await fetch(ALFABI_CONFIG.video);
        if (!response.ok) throw new Error('Video unavailable');
        const blob = await response.blob();
        if (failed || motion.matches) { loadingBlob = false; return; }
        blobURL = URL.createObjectURL(blob);
        visual.classList.remove('video-ready');
        video.src = blobURL; video.load();
      } catch { failVideo(); }
    }
    video.addEventListener('loadedmetadata', onMetadata);
    video.addEventListener('durationchange', onMetadata);
    video.addEventListener('loadeddata', frameAvailable);
    video.addEventListener('seeked', () => { frameAvailable(); scheduleSeek(); });
    video.addEventListener('canplay', scheduleSeek);
    video.addEventListener('progress', scheduleSeek);
    video.addEventListener('canplaythrough', () => { scheduleSeek(); ensureSeekable(); });
    video.addEventListener('error', failVideo);
    video.addEventListener('play', () => video.pause());
    document.getElementById('scroll-cue').addEventListener('click', () => {
      if (started && !motion.matches) window.scrollBy({ top: Math.min(distance * .28, innerHeight * .65), behavior: 'smooth' });
    });
    window.addEventListener('resize', refresh, { passive: true });
    window.addEventListener('pageshow', refresh);
    document.fonts?.ready.then(refresh);

    function start() {
      if (motion.matches) {
        staticScene(); visual.classList.remove('video-ready');
        return;
      }
      failed = false; visual.classList.remove('video-unavailable');
      if (!video.getAttribute('src')) { video.src = ALFABI_CONFIG.video; video.load(); }
      loadingTimer = setTimeout(() => {
        if (!visual.classList.contains('video-ready') && !failed) status.textContent = 'A cena está carregando. Sinta-se em casa.';
      }, 4500);
      loadLibraries().then(() => { setupScroll(); }).catch(() => {
        staticScene(); // Copy, poster and real contact links remain fully usable without CDN.
      });
      if (video.readyState >= 1) onMetadata();
      if (video.readyState >= 2) frameAvailable();
    }
    motion.addEventListener('change', start);
    // Start static until metadata + libraries are ready; no empty scroll on failure.
    document.documentElement.classList.add('scene-static');
    start();

</script>
