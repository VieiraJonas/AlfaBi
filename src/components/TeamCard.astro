---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  name: string;
  image: ImageMetadata;
  alt?: string;
  role?: string;
  color: string;
  shape: 'circle' | 'square' | 'arch';
  icon: 'heart' | 'spark' | 'book';
}

const {
  name,
  image,
  alt = `Avatar ilustrado de ${name}, da equipe ALFABI.`,
  role = 'Equipe ALFABI',
  color,
  shape,
  icon,
} = Astro.props;
---

<figure class="team-card" style={{ '--team-color': color }}>
  <div class="team-art">
    <span class:list={['team-shape', `team-${shape}`]} aria-hidden="true"></span>
    <Image
      src={image}
      width="1254"
      height="1254"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
      alt={alt}
      widths={[320, 480, 640, 960, 1254]}
      sizes="(max-width: 760px) min(420px, 90vw), (max-width: 1600px) 30vw, 464px"
      format="webp"
      quality={90}
    />
  </div>
  <figcaption>
    <h3>{name}</h3>
    <span>{role}</span>
    <svg aria-hidden="true"><use href={`#${icon}`} /></svg>
  </figcaption>
</figure>
