/* Visual polish — centered hero, quiet depth, consistent interaction rhythm. */
.hero-frame{min-height:700px;isolation:isolate;background:linear-gradient(180deg,#fdfcff 0%,#fff 76%)}
.hero-frame:before{content:'';position:absolute;inset:-18%;z-index:-2;pointer-events:none;background:radial-gradient(ellipse at 24% 25%,#1391e10b,transparent 35%),radial-gradient(ellipse at 76% 38%,#7648c30e,transparent 40%),radial-gradient(ellipse at 50% 80%,#ff692207,transparent 40%);animation:hero-atmosphere 22s ease-in-out infinite alternate}
.hero-frame:after{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(#7648c306 1px,transparent 1px),linear-gradient(90deg,#7648c306 1px,transparent 1px);background-size:70px 70px;mask-image:radial-gradient(ellipse at 50% 40%,#0004,transparent 68%)}
.hero-main{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);justify-items:center;gap:6px;padding-block:25px 0;align-items:center;min-height:0}
.hero-copy{align-self:start;padding:0;text-align:center;max-width:1020px;width:100%}
.hero-copy .eyebrow{justify-content:center;margin-bottom:14px;font-size:8px;letter-spacing:.16em}
.hero-title{font-size:clamp(44px,4.3vw,66px);line-height:1.12;letter-spacing:-.05em;max-width:1020px;margin:0 auto 19px;text-wrap:balance}
.hero-title .title-line{display:inline;white-space:normal}
.hero-title .title-line:first-child:after{content:' '}
.hero-title .title-line:nth-child(2){display:inline;white-space:nowrap}
.hero-title .title-final{display:block;width:max-content;max-width:100%;margin:1px auto 0;font-size:1.19em;line-height:1.09}
.hero-description{max-width:520px;margin:0 auto;font-size:12px;line-height:1.8}
.hero-actions{justify-content:center;margin:18px auto 0;gap:12px;max-width:none}
.hero-copy .btn{min-height:49px;padding-inline:23px;font-size:11px}
.small-promise{justify-content:center;margin-top:12px;font-size:9px}
.hero-visual{width:min(860px,88%);height:100%;min-height:0;max-height:none;aspect-ratio:auto;margin:0;align-self:stretch;position:relative}
.hero-visual:after{content:'';position:absolute;width:91%;height:67%;left:4.5%;top:18%;border:1px solid #7648c30d;border-radius:50%;transform:rotate(-7deg);z-index:-1;pointer-events:none}
.video-composition{width:100%;height:100%;max-height:430px;aspect-ratio:auto;left:0;transform:none}
.video-media{mask-image:linear-gradient(to right,transparent,#000 6%,#000 94%,transparent),linear-gradient(to bottom,transparent,#000 11%,#000 98%,transparent);mask-composite:intersect;-webkit-mask-image:linear-gradient(to right,transparent,#000 6%,#000 94%,transparent),linear-gradient(to bottom,transparent,#000 11%,#000 98%,transparent);-webkit-mask-composite:source-in}
.visual-glow{inset:2% -12%;background:radial-gradient(ellipse at 50% 75%,#7648c30b,transparent 60%);filter:blur(30px)}
.hero-visual .scene-label{left:-3%;top:23%;font-size:8px;letter-spacing:.12em}
.hero-visual .scene-signature{right:-4%;bottom:16%;font-size:8px}
.hero-visual .geometry-square{right:1%;top:20%;opacity:.6}
.hero-visual .geometry-dot{left:2%;top:45%;opacity:.7}
.hero-visual .geometry-arc{left:5%;bottom:20%;opacity:.65}
.hero-visual .geometry-star{right:8%;bottom:7%;opacity:.25}
.hero-visual .geometry-path{display:none}
.hero-bottom{min-height:64px;border-top-color:#e7e2f080}
.title-stroke{bottom:-8px;opacity:.7}
.title-stroke path{stroke-dasharray:1;stroke-dashoffset:1;animation:ink-reveal 1.6s .35s var(--ease) forwards}
.site-header{background:#ffffffce;backdrop-filter:blur(20px) saturate(1.15)}
.site-header.is-scrolled{background:#fffffff0;box-shadow:0 6px 28px #25213b08}
.site-header:after{content:'';position:absolute;bottom:0;left:0;width:100%;height:1px;pointer-events:none;background:linear-gradient(90deg,var(--brand-blue),var(--brand-green),var(--brand-orange),var(--brand-purple));transform:scaleX(var(--page-progress,0));transform-origin:left;opacity:.65}
.header-inner{border-color:#e7e2f070}
.header-contact{min-height:44px}
.btn{transition:transform .45s var(--ease),background .3s,box-shadow .45s var(--ease),border-color .3s;box-shadow:0 2px 4px #25213b02}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 26px #7648c314}
.btn-primary{box-shadow:0 5px 17px #7648c31c,inset 0 1px 0 #ffffff20}
.btn-primary:hover{box-shadow:0 10px 25px #7648c329,inset 0 1px 0 #ffffff20}
.btn-beam:after{animation-duration:11s;opacity:.16;transition:opacity .4s}
.btn-beam:hover:after{opacity:.65}
.btn-secondary{background:#ffffffad}
.btn:focus-visible,.round-button:focus-visible,.menu-toggle:focus-visible{outline:3px solid #7648c399;outline-offset:4px}
.chapter h2{text-wrap:balance}.chapter:before{animation-duration:25s;animation-play-state:paused}.chapter.is-inview:before{animation-play-state:running}
.mission-section:before{background:radial-gradient(ellipse at 80% 25%,#7648c30d,transparent 45%),radial-gradient(ellipse at 8% 85%,#1391e10a,transparent 40%)}
.about-section:before{background:radial-gradient(ellipse at 30% 70%,#1391e108,transparent 45%),radial-gradient(ellipse at 80% 18%,#ff692208,transparent 38%)}
.contact-section:before{background:radial-gradient(ellipse at 10% 65%,#7648c312,transparent 45%),radial-gradient(ellipse at 90% 20%,#1391e10b,transparent 38%)}
.chapter:not(.is-inview) .discovery-art>img{animation-play-state:paused}
.steam-card{box-shadow:0 4px 18px #25213b03;transition:transform .55s var(--ease),box-shadow .55s,border-color .4s}
.steam-card:hover{transform:translateY(-4px);box-shadow:0 16px 35px #25213b09}
.steam-card:hover .steam-image img{transform:rotate(-2deg) scale(1.025)}
.steam-card p{font-size:12px;line-height:1.85}
.review-card{background:linear-gradient(135deg,#fff,#fdfbff);transition:border-color .4s,box-shadow .4s}
.review-card:hover{border-color:#d8caeb;box-shadow:0 9px 25px #7648c308}
.team-card{box-shadow:0 5px 24px #25213b03;transition:box-shadow .5s,border-color .5s}
.team-card:hover{border-color:#d8caeb;box-shadow:0 16px 35px #7648c30b}
.team-card:hover img{transform:scale(1.025) translateY(-2px)}
.panel{box-shadow:0 12px 45px #7648c306}
.contact-form:focus-within{border-color:#d2bfe9;box-shadow:0 15px 50px #7648c30a}
.form-field input,.form-field textarea{font-size:13px;padding:13px 14px;min-height:48px}
.form-field label{font-size:11px}.form-note{font-size:10px}.form-status{font-size:11px}
.form-field input:hover,.form-field textarea:hover{border-color:#bdabd4}
.will-reveal{transition-duration:.85s;transition-timing-function:var(--ease)}
.will-reveal:not(.active){transform:translateY(20px);filter:blur(3px)}
.reveal-zoom.will-reveal:not(.active){transform:scale(.975)}
.site-footer{isolation:isolate;background:linear-gradient(135deg,#292039,#30223f)}
.site-footer:before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 95% 0%,#b08ae018,transparent 55%);pointer-events:none}
.footer-column>a,.footer-column>p{font-size:11px}.footer-bottom{font-size:9px}.footer-about p{font-size:12px}
