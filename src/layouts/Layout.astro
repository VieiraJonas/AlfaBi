---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ALFABI — Cada descoberta começa com acolhimento',
  description = 'Na ALFABI, cada descoberta começa com acolhimento. Um espaço para aprender, desenvolver habilidades e crescer com afeto.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=alfabi">
  <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico?v=alfabi">
  <link rel="preload" as="font" type="font/ttf" href="/assets/hero/fonts/Pamit.ttf" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/assets/cd36de204aca2d5f_Poppins-500.woff2" crossorigin>
  <link rel="preload" as="image" href="/assets/hero/poster.webp">
  <slot name="head" />
</head>
<body>

  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <svg class="svg-defs" aria-hidden="true"><defs>
    <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></symbol>
    <symbol id="chat" viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.8 7.3L3 20l1.3-5A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8 11h.01M12 11h.01M16 11h.01"/></symbol>
    <symbol id="heart" viewBox="0 0 24 24"><path d="m12 20-8-8a5 5 0 0 1 8-6 5 5 0 0 1 8 6z"/></symbol>
    <symbol id="down" viewBox="0 0 24 24"><path d="M12 4v16m-6-6 6 6 6-6"/></symbol>
    <symbol id="spark" viewBox="0 0 24 24"><path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z"/></symbol>
<symbol id="menu" viewBox="0 0 24 24"><path d="M4 8h16M4 16h16"/></symbol><symbol id="close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol><symbol id="chevron" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol><symbol id="book" viewBox="0 0 24 24"><path d="M12 5C9 3 5 3 2 4v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-3-1-7-1-10 1Zm0 0v15"/></symbol><symbol id="instagram" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></symbol><symbol id="pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></symbol>
  </defs></svg>
  <Header />
  <slot />
  <Footer />
</body>
</html>

  <style is:global>
    /* Identity, type, radii and motion extracted from design_system.html.
       Official Pamit and Poppins files are relative assets. Logo artwork is preserved. */
    @font-face{font-family:Poppins;src:url('/assets/hero/fonts/Poppins-Regular.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
    @font-face{font-family:Poppins;src:url('/assets/cd36de204aca2d5f_Poppins-500.woff2') format('woff2');font-style:normal;font-weight:500;font-display:swap}
    @font-face{font-family:Poppins;src:url('/assets/f4e80d9dfd374d02_Poppins-600.woff2') format('woff2');font-style:normal;font-weight:600;font-display:swap}
    @font-face{font-family:Pamit;src:url('/assets/hero/fonts/Pamit.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
    :root{--brand-blue:#1391e1;--brand-red:#f01312;--brand-green:#09ad4a;--brand-orange:#ff6922;--brand-purple:#7648c3;--ink:#25213b;--muted:#666177;--paper:#fff;--surface:#f8f7fc;--line:#e7e2f0;--sans:Poppins,Arial,sans-serif;--display:Pamit,Poppins,Arial,sans-serif;--ease:cubic-bezier(.16,1,.3,1);--nav-height:100px;--page-width:1440px;--gutter:clamp(24px,5vw,88px)}
    *{box-sizing:border-box}html{background:var(--paper);scrollbar-gutter:stable}body{margin:0;font:400 15px/1.7 var(--sans);color:var(--ink);background:white;-webkit-font-smoothing:antialiased;overflow-x:clip}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit;text-decoration:none}button{font:inherit}button,a{touch-action:manipulation}::selection{background:#e2d6f3;color:var(--ink)}:focus-visible{outline:3px solid var(--brand-purple);outline-offset:5px}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.svg-defs{position:absolute;width:0;height:0;overflow:hidden}.wrap{width:min(var(--page-width),100% - var(--gutter)*2);margin-inline:auto}.skip-link{position:fixed;top:-100px;left:24px;z-index:100;background:var(--brand-purple);color:#fff;padding:12px 20px;border-radius:8px}.skip-link:focus{top:15px}
    .site-header{position:absolute;inset:0 0 auto;z-index:20;height:var(--nav-height);background:#ffffffed}.header-inner{height:100%;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #e7e2f08c}.brand{display:flex;align-items:center;gap:19px;flex-shrink:0}.brand img{width:105px;height:77px;object-fit:contain;display:block}.brand-divider{height:30px;width:1px;background:var(--line)}.brand-caption{font-size:10px;line-height:1.65;letter-spacing:.035em;color:var(--muted)}.header-message{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:9px}.header-message:before{content:'';height:5px;width:5px;background:var(--brand-green);border-radius:50%}.header-contact{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:500;transition:color .3s}.header-contact:hover{color:var(--brand-purple)}.header-contact .contact-icon{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;transition:background .3s,transform .4s var(--ease)}.header-contact:hover .contact-icon{background:#f1ebfa;transform:rotate(-8deg)}.header-contact svg{width:15px;height:15px}
    .hero-scene{position:relative;isolation:isolate}.hero-frame{position:sticky;top:0;min-height:700px;height:100svh;display:flex;flex-direction:column;overflow:clip;background:white;padding-top:var(--nav-height)}.hero-main{display:grid;grid-template-columns:44% 56%;align-items:center;flex:1;position:relative;padding-block:55px 40px;min-height:0}.hero-copy{position:relative;z-index:3;align-self:center;padding-bottom:30px}.eyebrow{display:flex;align-items:center;gap:11px;margin:0 0 24px;font-size:9px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}.eyebrow-mark{width:21px;height:21px;display:grid;place-items:center;color:var(--brand-purple);font-size:27px;font-family:Arial,sans-serif;line-height:1}.hero-title{font:500 clamp(43px,4.95vw,76px)/1.16 var(--display);letter-spacing:-.055em;margin:0 0 25px;max-width:680px}.title-line{display:block;white-space:nowrap}.title-blue{color:var(--brand-blue)}.text-outline{color:transparent;-webkit-text-stroke:1.25px var(--brand-purple);font-weight:500;position:relative}.title-final{position:relative;display:inline-block}.title-stroke{position:absolute;left:2%;bottom:-11px;width:94%;height:15px;stroke:var(--brand-orange);stroke-width:2.5;fill:none;opacity:.7;pointer-events:none}.hero-description{font-size:14px;line-height:1.9;letter-spacing:-.015em;color:var(--muted);max-width:360px;margin:0}.hero-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:29px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:52px;border-radius:999px;border:1px solid var(--line);padding:0 22px;font-size:11px;font-weight:500;position:relative;background:white;color:var(--ink);transition:transform .45s var(--ease),background .3s,box-shadow .45s var(--ease),border-color .3s;white-space:nowrap}.btn svg{height:16px;width:16px;transition:transform .4s var(--ease)}.btn:hover{transform:translateY(-3px);box-shadow:0 10px 30px #7648c311}.btn:hover svg{transform:translate(2px,-2px)}.btn:active{transform:translateY(0);box-shadow:none}.btn-primary{background:var(--brand-purple);border-color:var(--brand-purple);color:white;box-shadow:0 8px 24px #7648c31a}.btn-primary:hover{background:#653bad;border-color:#653bad}.btn-primary:active{background:#563294}.btn-secondary:hover{background:var(--surface);border-color:#d1c2e7}.btn-beam{isolation:isolate;overflow:hidden}.btn-beam:after{content:'';position:absolute;inset:-150%;background:conic-gradient(transparent 67%,#ffffff00 74%,#ffffff40 80%,transparent 87%);animation:beam 7s linear infinite;z-index:-1;pointer-events:none}.small-promise{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:8px;margin:22px 0 0}.small-promise svg{width:13px;height:13px;color:var(--brand-purple)}
    .hero-visual{position:relative;isolation:isolate;min-width:0;align-self:center;aspect-ratio:1.16;display:grid;place-items:center;margin-top:-18px}.visual-glow{position:absolute;inset:4% -7%;background:radial-gradient(ellipse at 57% 66%,#7648c309,transparent 66%),radial-gradient(ellipse at 20% 45%,#1391e10a,transparent 64%);filter:blur(20px);z-index:-2}.video-composition{position:relative;width:112%;left:0;aspect-ratio:16/9;isolation:isolate;z-index:1;transform:translateY(15px)}.video-media{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;mix-blend-mode:multiply;mask-image:linear-gradient(to right,transparent,#000 5%,#000 95%,transparent);-webkit-mask-image:linear-gradient(to right,transparent,#000 5%,#000 95%,transparent)}.video-poster{z-index:1}.hero-video{z-index:2;opacity:0;transition:opacity .35s}.video-ready .hero-video{opacity:1}.video-ready .video-poster{opacity:0}.video-unavailable .hero-video{display:none}.video-unavailable .video-poster{opacity:1}.video-state{position:absolute;left:50%;bottom:3%;transform:translateX(-50%);font-size:10px;color:var(--muted);margin:0;white-space:nowrap;z-index:4}.video-state:empty{display:none}.scene-label{position:absolute;left:13%;top:7%;display:flex;align-items:center;gap:7px;font-size:9px;letter-spacing:.08em;color:var(--muted);z-index:3}.scene-label .tiny-dot{width:4px;height:4px;border-radius:50%;background:var(--brand-purple)}.scene-signature{position:absolute;right:2%;bottom:9%;font-size:9px;letter-spacing:.035em;display:flex;align-items:center;gap:8px;color:var(--muted);z-index:3}.color-dots{display:flex;gap:3px}.color-dots i{width:5px;height:5px;background:var(--brand-blue);border-radius:50%}.color-dots i:nth-child(2){background:var(--brand-red)}.color-dots i:nth-child(3){background:var(--brand-green)}.color-dots i:nth-child(4){background:var(--brand-orange)}.color-dots i:nth-child(5){background:var(--brand-purple)}
    .geometry{position:absolute;pointer-events:none;z-index:-1;will-change:transform}.geometry-square{width:42px;height:42px;border:1px solid #1391e14d;border-radius:10px;right:4%;top:4%;transform:rotate(17deg)}.geometry-dot{width:12px;height:12px;background:#ff692225;border-radius:50%;top:16%;left:7%}.geometry-arc{width:50px;height:25px;bottom:10%;left:9%;border-radius:0 0 50px 50px;border:1px solid #7648c350;transform:rotate(-22deg)}.geometry-star{color:var(--brand-green);opacity:.35;right:8%;bottom:3%;width:23px;height:23px}.geometry-path{position:absolute;left:-3%;top:13%;width:84px;height:90px;stroke:#7648c31b;stroke-width:1.2;fill:none;z-index:-1}.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:75px;border-top:1px solid #e7e2f08c;position:relative;z-index:3}.bottom-note{font-size:9px;color:var(--muted);display:flex;align-items:center;gap:9px}.bottom-note svg{width:13px;height:13px;color:var(--brand-purple)}.scroll-cue{display:flex;align-items:center;gap:12px;font-size:9px;letter-spacing:.06em;color:var(--muted);padding:10px 0;border:0;background:transparent;cursor:pointer}.scroll-cue svg{width:14px;height:14px;animation:nudge 2.6s var(--ease) infinite}.scene-progress{display:flex;align-items:center;gap:10px}.progress-track{height:2px;width:74px;background:var(--line);overflow:hidden;border-radius:10px}.progress-fill{display:block;width:100%;height:100%;background:var(--brand-purple);transform:scaleX(0);transform-origin:left}.progress-label{font-size:9px;font-variant-numeric:tabular-nums;color:var(--muted);min-width:27px}.scene-static .hero-scene{height:auto!important}.scene-static .hero-frame{position:relative}.scene-static .scene-progress{visibility:hidden}.scene-static .scroll-cue{display:none}.scene-static .video-state{white-space:normal;text-align:center;width:90%}.scene-static .hero-bottom{justify-content:space-between}
    .site-header{position:fixed}.hero-title,.text-outline{font-weight:400}
    .video-media{mask-image:linear-gradient(to right,transparent,#000 5%,#000 95%,transparent),linear-gradient(to bottom,transparent,#000 12%,#000 97%,transparent);mask-composite:intersect;-webkit-mask-image:linear-gradient(to right,transparent,#000 5%,#000 95%,transparent),linear-gradient(to bottom,transparent,#000 12%,#000 97%,transparent);-webkit-mask-composite:source-in}
    @keyframes nudge{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}@keyframes beam{to{transform:rotate(360deg)}}
    @media(min-width:1700px){.hero-title{font-size:78px}.hero-visual{aspect-ratio:1.25}.hero-main{gap:12px}}
    @media(max-width:1100px){:root{--nav-height:86px;--gutter:38px}.header-message{display:none}.hero-title{font-size:clamp(41px,4.9vw,58px)}.hero-actions{gap:9px}.btn{padding-inline:17px;font-size:10px;gap:10px}.hero-description{font-size:13px;max-width:320px}.hero-main{grid-template-columns:45% 55%}.scene-signature{right:0}.hero-visual{aspect-ratio:1.05}.hero-copy{padding-bottom:18px}.eyebrow{font-size:8px;letter-spacing:.1em}}
    @media(max-width:760px){:root{--nav-height:79px;--gutter:25px}.brand img{width:83px;height:64px}.brand-caption{font-size:8px}.brand{gap:11px}.brand-divider{height:24px}.header-contact{font-size:10px;gap:7px}.header-contact .contact-icon{width:31px;height:31px}.hero-frame{min-height:690px;height:100svh}.hero-main{grid-template-columns:1fr;grid-template-rows:auto 1fr;align-content:center;padding-block:30px 0;gap:0}.hero-copy{padding-bottom:0;align-self:start}.eyebrow{margin-bottom:17px;font-size:8px;letter-spacing:.13em}.hero-title{font-size:clamp(35px,7.8vw,54px);line-height:1.15;letter-spacing:-.048em;margin-bottom:19px}.hero-title .title-line:first-child{display:inline}.hero-title .title-line:nth-child(2){display:block}.hero-title .title-final{display:block;width:max-content}.hero-description{font-size:12px;line-height:1.8;max-width:335px}.hero-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;max-width:400px;margin-top:20px}.btn{font-size:10px;min-height:49px;padding:0 12px;gap:8px}.btn svg{width:13px;height:13px;flex-shrink:0}.small-promise{font-size:9px;margin-top:13px}.hero-visual{aspect-ratio:auto;width:100%;height:100%;min-height:220px;margin-top:0;align-self:stretch}.video-composition{width:min(112%,620px);transform:translateY(0)}.scene-label{left:0;top:10%;font-size:8px}.scene-signature{bottom:2%;right:1%;font-size:8px}.geometry-square{right:2%;top:8%;width:27px;height:27px;border-radius:7px}.geometry-dot{left:4%;top:20%;width:9px;height:9px}.geometry-arc{left:0;bottom:12%;width:30px;height:15px}.geometry-star{right:0;bottom:6%;width:17px;height:17px}.geometry-path{display:none}.hero-bottom{min-height:56px;gap:10px}.bottom-note{font-size:8px;gap:6px}.bottom-note svg{width:11px}.scroll-cue{font-size:8px;gap:7px}.scene-progress{gap:6px}.progress-track{width:34px}.progress-label{font-size:8px;min-width:22px}.video-state{font-size:8px;bottom:10%}.title-stroke{bottom:-7px;height:12px}}
    @media(max-width:760px) and (max-height:760px){:root{--nav-height:67px}.brand img{height:55px;width:75px}.hero-frame{min-height:620px}.hero-main{padding-top:21px}.hero-title{font-size:34px;line-height:1.1;margin-bottom:16px}.eyebrow{margin-bottom:12px}.hero-description{font-size:11px;max-width:320px}.hero-actions{margin-top:15px}.small-promise{margin-top:10px;font-size:8px}.hero-visual{min-height:178px}.hero-bottom{min-height:45px}.scene-label{top:5%}.scene-signature{bottom:0}.bottom-note{max-width:135px;line-height:1.5}.scroll-cue{font-size:7px}}
    @media(max-width:370px){:root{--gutter:20px}.brand-caption,.brand-divider{display:none}.hero-title{font-size:32px}.btn{font-size:9px;padding-inline:8px;gap:6px}.btn-primary svg{display:none}.scene-progress{display:none}.bottom-note{font-size:7px}}
    @media(min-width:761px) and (max-height:740px){.hero-frame{min-height:620px}.hero-main{padding-block:30px 15px}.hero-title{font-size:clamp(42px,4.7vw,65px)}.hero-visual{max-height:450px}.hero-bottom{min-height:60px}}
    @media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}.hero-frame{position:relative}.scroll-cue,.scene-progress{display:none}}
  /* Following chapters — design_system.html: chapter / panel / reveal-up / text-outline. */
